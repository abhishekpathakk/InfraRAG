# InfraRAG Environment Configuration Template

# AWS Region & Bedrock Configuration
AWS_REGION=ap-south-1
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_LLM_MODEL_ID=amazon.nova-micro-v1:0

# Execution Modes: local (384-dim FastEmbed ONNX), mock (1024-dim Hash), or bedrock (AWS Titan)
EMBEDDING_PROVIDER=local
USE_MOCK_BEDROCK=true

# AWS SES Stakeholder Digest Dispatch Configuration
# In SES Sandbox, both sender and recipients must be verified in AWS SES
SES_SENDER_EMAIL=abhisheknaa@gmail.com
SES_RECIPIENT_EMAILS=mr.abhishekpathak@gmail.com
SEND_SES_EMAIL=false
